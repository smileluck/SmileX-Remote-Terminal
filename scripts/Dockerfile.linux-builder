# Linux 打包环境（Ubuntu 22.04 基座，对应 Tauri v2 的 WebKitGTK 4.1 依赖）
# 仅供 scripts/build-linux-docker.sh 使用；镜像不含源码，构建时挂载仓库
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl wget git file pkg-config libssl-dev patchelf \
    libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

# Node 20 + pnpm 8（与根 package.json 的 packageManager 对齐）
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@8.15.0 --activate

# Rust stable（含 musl 之外的默认 GNU target，x86_64 容器即 x86_64 产物）
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

COPY scripts/linux-builder-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
