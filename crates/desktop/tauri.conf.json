{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmileX-Remote-Terminal",
  "version": "0.1.5",
  "identifier": "com.smilex.remote-terminal",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:6173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SmileX Remote Terminal",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2RjU2OEZFMzEzMjYxNwpSV1FYSmhQamoxWnZBc3RJeFhJSS93K1RWc3czRUI5alh5SXQ0WDgrOEFEczExSXJ6eEZiYk1VRwo=",
      "endpoints": [
        "https://github.com/smileluck/SmileX-Remote-Terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
