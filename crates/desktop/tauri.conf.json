{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmileX-Remote-Terminal",
  "version": "0.1.5",
  "identifier": "com.smilex.remote-terminal",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:6173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SmileX Remote Terminal",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
