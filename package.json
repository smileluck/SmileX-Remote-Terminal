{
  "name": "smilex-remote-terminal",
  "version": "0.1.5",
  "description": "跨平台综合运维工具：SSH 终端 + 远程桌面 + AI 助手",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "preview": "pnpm --filter app preview",
    "tauri": "app/node_modules/.bin/tauri",
    "build:mac": "app/node_modules/.bin/tauri build",
    "build:mac-universal": "app/node_modules/.bin/tauri build --target universal-apple-darwin",
    "build:linux": "bash scripts/build-linux-docker.sh",
    "version:bump": "node scripts/sync-version.mjs"
  }
}
